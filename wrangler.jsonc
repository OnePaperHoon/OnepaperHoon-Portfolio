{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onepaperhoon-portfolio",
  "compatibility_date": "2026-08-01",
  // Assets-only deployment: Astro가 빌드한 정적 파일(dist/)만 올립니다.
  // Worker 코드, DB, 버킷 없음. 콘텐츠는 src/content/ 의 마크다운을 고치고 다시 배포합니다.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "onepaperhoon.com", "custom_domain": true },
    { "pattern": "www.onepaperhoon.com", "custom_domain": true }
  ]
}
