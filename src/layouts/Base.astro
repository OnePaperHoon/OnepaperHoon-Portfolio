---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 첫 화면에서 종이비행기가 날아 들어와 펼쳐지는 인트로 */
  flyIn?: boolean;
  type?: "website" | "article";
}
const { title, description = site.description, image = "/og.jpg", flyIn = false, type = "website" } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const verification = import.meta.env.VITE_GOOGLE_SITE_VERIFICATION;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.author,
  alternateName: site.name,
  url: site.url,
  sameAs: [site.github],
};
---

<!doctype html>
<html lang="ko" data-paper-intro={flyIn ? "fly-in" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#3647c9" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} notes`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {verification && !verification.startsWith("REPLACE") && <meta name="google-site-verification" content={verification} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@800;900&family=JetBrains+Mono:wght@400;500&display=swap" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    <ClientRouter />
    <script is:inline>
      // 방문자의 지금 시각 → 첫 장면의 시간대. 그리기 전에 정해야 깜빡이지 않습니다. (?now=night 로 미리보기)
      (() => {
        const phases = ["dawn", "day", "dusk", "night"];
        const apply = () => {
          let asked = new URLSearchParams(location.search).get("now");
          // 미리보기는 페이지를 옮겨 다녀도 이 탭에서 유지됩니다.
          try { if (phases.includes(asked)) sessionStorage.setItem("now", asked); else asked = sessionStorage.getItem("now"); } catch {}
          const hour = new Date().getHours();
          const now = hour >= 5 && hour < 9 ? "dawn" : hour >= 9 && hour < 17 ? "day" : hour >= 17 && hour < 20 ? "dusk" : "night";
          document.documentElement.dataset.now = phases.includes(asked) ? asked : now;
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- 종이 무대: 페이지를 이동해도 같은 캔버스가 유지됩니다 -->
    <div id="sky-root" transition:persist="sky-root" aria-hidden="true"></div>
    <div id="paper-root" transition:persist="paper-root" transition:name="paper-stage" aria-hidden="true"></div>

    <script>
      import { mountSky } from "@/scripts/sky";
      import { mountTerminals } from "@/scripts/terminal";

      // ClientRouter 아래에서 모듈 스크립트는 한 번만 실행되므로, 페이지마다 할 일은 astro:page-load에 겁니다.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      let observer: IntersectionObserver | undefined;

      document.addEventListener("astro:page-load", () => {
        // 스크롤 등장
        observer?.disconnect();
        observer = new IntersectionObserver(
          (entries) => entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-in");
            observer?.unobserve(entry.target);
          }),
          { threshold: 0.15, rootMargin: "0px 0px -6% 0px" },
        );
        document.querySelectorAll<HTMLElement>("[data-rise]").forEach((el) => observer?.observe(el));

        mountTerminals();

        // 종이 무대와 셰이더 하늘: 동작 줄이기를 켠 환경에서는 CSS 종이 카드와 그라데이션으로 둡니다.
        if (!reduced.matches) {
          mountSky();
          import("@/scripts/paper/stage").then(({ mountPaper }) => mountPaper()).catch(() => undefined);
        }
      });
    </script>
  </body>
</html>
