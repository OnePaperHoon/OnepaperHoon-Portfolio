---
import PaperSlot from "./PaperSlot.astro";
import { site } from "@/site";
interface Props {
  lang?: "ko" | "en";
}
const { lang = "ko" } = Astro.props;
const en = lang === "en";
---

<footer class="scene sky footer" id="contact" data-step="2" data-sky data-tone-zone="dark">
  <div class="scene__grain" aria-hidden="true"></div>
  <div class="horizon" aria-hidden="true"></div>
  <div class="shell footer__grid">
    <div>
      <h2 class="footer__title" data-rise>{en ? <>One page<br />is enough.</> : <>한 장이면<br />충분합니다.</>}</h2>
      <p class="footer__text" data-rise style="--i:1">{en ? "If there is something you want built, or a problem worth solving together, write it on one page and send it over. Paper planes accepted." : "만들고 싶은 것, 같이 풀고 싶은 문제가 있다면 한 장 분량으로 적어 보내주세요. 종이비행기로 접어 보내도 받습니다."}</p>
      <div class="footer__actions" data-rise style="--i:2">
        <a class="pill pill--light" href={`mailto:${site.email}`} data-paper-launch>{en ? "Send an email" : "메일 보내기"}</a>
        <a class="pill pill--ghost" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </div>
    <PaperSlot class="footer__slot" label={en ? "To. Janghoon" : "To. 한장훈"} title={en ? "Thank you for reading this far." : "여기까지 읽어주셔서 고맙습니다."} body={en ? "The next page is yours." : "다음 한 장은 당신 차례."} foot="fin." tilt="0,0,0" shadow={0} backlit={0.16} fold="plane" hint={en ? "Tap to launch" : "눌러서 날려보세요"} />
  </div>
  <div class="shell footer__base">
    <a class="brand" href="/">onepaperhoon</a>
    <span>© {new Date().getFullYear()} {site.author} · Seoul, KR</span>
    <nav class="footer__links" aria-label="바깥 링크">
      <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={en ? "/en#about" : "/about"}>About</a>
      <a href="/notes">Notes</a>
      <a href={en ? "/" : "/en"}>{en ? "한국어" : "English"}</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>
