---
const path = Astro.url.pathname;
const links = [
  { href: "/#work", label: "Work", current: path.startsWith("/work") },
  { href: "/notes", label: "Notes", current: path.startsWith("/notes") },
  { href: "#contact", label: "Contact", current: false },
];
---

<header class="site-header" data-tone="light">
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label="onepaperhoon 홈">
      <span class="brand__sheet" aria-hidden="true"></span>
      <span>onepaperhoon</span>
    </a>
    <nav class="site-nav" aria-label="주요 메뉴">
      {links.map((link) => <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>)}
      <span class="site-tools">
        <button class="tool" type="button" data-pen-toggle aria-pressed="false" aria-label="종이에 낙서하기" title="종이에 낙서하기">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1-4.5L16.5 4a2.1 2.1 0 0 1 3 3L8 18.5z" /><path d="M14.5 6l3 3" /></svg>
        </button>
        <button class="tool" type="button" data-term-toggle aria-label="터미널 열기 (` 키)" title="터미널  `">&gt;_</button>
      </span>
    </nav>
  </div>
</header>

<script>
  // 헤더 아래에 깔린 구간의 밝기에 맞춰 글자색을 바꿉니다. 헤더와 구간은 페이지마다 새로 생기므로 매번 다시 찾습니다.
  const update = () => {
    const header = document.querySelector<HTMLElement>(".site-header");
    if (!header) return;
    const probe = 42;
    const zone = [...document.querySelectorAll<HTMLElement>("[data-tone-zone]")].find((el) => {
      const rect = el.getBoundingClientRect();
      return rect.top <= probe && rect.bottom > probe;
    });
    header.dataset.tone = zone?.dataset.toneZone ?? "light";
    header.classList.toggle("is-scrolled", window.scrollY > 24);
  };
  document.addEventListener("astro:page-load", update);
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
</script>
