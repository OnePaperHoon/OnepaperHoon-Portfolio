---
/**
 * 만져볼 수 있는 케이스 스터디 상자. 작업 frontmatter의 `demo:` 값으로 고릅니다.
 * 실제 동작은 src/scripts/demos.ts가 [data-demo-stage] 안에 세웁니다.
 */
interface Props {
  name: "cca-init" | "cda-init" | "yen-board" | "roulette";
  live?: string;
}
const { name, live } = Astro.props;
const copy = {
  "cca-init": { title: "설치를 직접 진행해 보세요", text: "남의 설정 파일을 건드리는 도구가 어떻게 물어보고, 보여주고, 확인받는지. 선택에 따라 결과가 달라집니다." },
  "cda-init": { title: "설치를 직접 진행해 보세요", text: "이벤트를 고르고, 변경을 미리 보고, 적용합니다. Codex만의 마지막 한 단계(trust)까지." },
  "yen-board": { title: "같은 10분, 다른 채널", text: "왼쪽은 매분 새 알림을 보내는 방식, 오른쪽은 YenWatch처럼 메시지 하나를 계속 고치는 방식입니다. 읽지 않은 알림 숫자를 보세요." },
  roulette: { title: "여기서 바로 돌려보세요", text: "실제 서비스의 목록 일부를 가져온 작은 버전입니다." },
}[name];
const note = name === "roulette" ? "전체 목록과 필터, PNG 카드 저장은 실제 서비스에 있습니다." : "README에 적힌 동작을 재현한 데모입니다. 실제 도구를 실행하지 않으며, 화면의 문구는 실제와 다를 수 있습니다.";
---

<section class="demo" data-demo={name}>
  <header class="demo__head">
    <p class="eyebrow demo__eyebrow">직접 해보기</p>
    <h2>{copy.title}</h2>
    <p>{copy.text}</p>
  </header>
  <div class="demo__stage" data-demo-stage>
    <p class="demo__fallback">이 데모는 자바스크립트가 켜져 있어야 움직입니다.</p>
  </div>
  <p class="demo__note">{note} {live && <a href={live} target="_blank" rel="noreferrer">실제 서비스 열기 ↗</a>}</p>
</section>
